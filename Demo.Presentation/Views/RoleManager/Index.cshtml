@model IEnumerable<RoleViewModel>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Trigger Button -->
<button type="button" class="btn btn-success mt-4 mb-4" data-bs-toggle="modal" data-bs-target="#CreateModal">
    Add New Role
</button>

<!-- Modal -->
<div class="modal fade" id="CreateModal" tabindex="-1" aria-labelledby="CreateModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">

            <!-- Modal Header -->
            <div class="modal-header">
                <h5 class="modal-title" id="CreateModalLabel">Create New Role</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <!-- Modal Body -->
            <div class="modal-body">
                <form method="post" asp-action="Create">
                    <div class="mb-3">
                        <label class="form-label">Role Name</label>
                        <input type="text" class="form-control" name="roleName" placeholder="Enter role name">
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary" >Save</button>
                    </div>
                </form>
            </div>

            <!-- Modal Footer -->


        </div>
    </div>
</div>
<h1>All Roles</h1>
<br />
<div class="m-2">
    <form asp-action="index" class="row offset-2" method="get">
        <div class="col-8">
            <input class="form-control" type="text" name="RoleSearchName" placeholder="Search for Role" />
        </div>
        <div class="col-4">
            <input type="submit" class="btn btn-outline-success" value="Search" />

        </div>
    </form>

</div>

<table class="table table-striped table-hover mt-3">
    <thead class="text-center">
        <tr>
            <th class="col-6">@Html.DisplayNameFor(u => u.Id)</th>
            <th>@Html.DisplayNameFor(u => u.RoleName)</th>
            <th>Details </th>
            <th>Update</th>
            <th>Delete</th>
        </tr>
    </thead>
    <tbody class="text-center">
        @foreach (var role in Model)
        {
            <tr>
                <td>@role.Id</td>
                <td>@role.RoleName</td>
                <td>
                    <a asp-action="Details" asp-route-id="@role.Id" class="text-info fs-4" title="Details">
                        <i class="fas fa-eye"></i>
                    </a>
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@role.Id" class="text-warning fs-5 mx-1" title="Edit">
                        <i class="fas fa-edit"></i>
                    </a>
                </td>
                <td>
                    <a asp-action="Delete" asp-route-id="@role.Id" class="text-danger fs-5 mx-1" title="Delete">
                        <i class="fas fa-trash"></i>
                    </a>
                </td>

            </tr>
        }
    </tbody>
</table>

