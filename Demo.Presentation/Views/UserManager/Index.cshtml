@model IEnumerable<UserDetailsViewModel>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<h1>All Users</h1>
<br />
<div class="m-2">
    <form asp-action="index" class="row offset-2" method="get">
        <div class="col-8">
            <input class="form-control" type="text" name="UserSearchName" placeholder="Search for User" />
        </div>
        <div class="col-4">
            <input type="submit" class="btn btn-outline-success" value="Search" />

        </div>
    </form>

</div>

<table class="table table-striped table-hover mt-3">
    <thead class="text-center">
        <tr>
            <th>@Html.DisplayNameFor(u => u.Id)</th>
            <th>@Html.DisplayNameFor(u => u.FirstName)</th>
            <th>@Html.DisplayNameFor(u => u.LastName)</th>
            <th>@Html.DisplayNameFor(u => u.Email)</th>
            <th>@Html.DisplayNameFor(u => u.PhoneNumber)</th>
            <th>Roles </th>
            <th>Details </th>
            <th>Update</th>
            <th>Delete</th>
        </tr>
    </thead>
    <tbody class="text-center">
        @foreach (var user in Model)
        {
            <tr>
                <td>@user.Id</td>
                <td>@user.FirstName</td>
                <td>@user.LastName</td>
                <td>@user.Email</td>
                <td>@user.PhoneNumber</td>
                <td></td>
                <td>
                    <a asp-action="Details" asp-route-id="@user.Id" class="text-info fs-4" title="Details">
                        <i class="fas fa-eye"></i>
                    </a>
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@user.Id" class="text-warning fs-5 mx-1" title="Edit">
                        <i class="fas fa-edit"></i>
                    </a>
                </td>
                <td>
                    <a asp-action="Delete" asp-route-id="@user.Id" class="text-danger fs-5 mx-1" title="Delete">
                        <i class="fas fa-trash"></i>
                    </a>
                </td>
                


            </tr>
        }
    </tbody>
</table>

