@model IEnumerable<DepartmentDTO> // Determine The model
@{
    ViewData["Title"] = "Index";
}

<h1 class="my-3">All Departments</h1>
<a class="btn btn-primary my-3" asp-controller="Department" asp-action="Create">Create New Department</a>
<br />

@if(Model?.Any()?? false)
{
    //Department
    <table class="table table-striped table-hover mt-2">
        <thead class="text-center fw-bold">
            <tr>
                <th>@Html.DisplayNameFor(D=>D.Code)</th>
                <th>@Html.DisplayNameFor(D=>D.Name)</th>
                <th>@Html.DisplayNameFor(D=>D.Description)</th>
                <th>@Html.DisplayNameFor(D=>D.DateOfCreation)</th>
                <th>Details</th>
                <th>Update</th>
                <th>Delete</th>
            </tr>
        </thead>
        <tbody>
            @foreach(var department in Model){
                <tr class="text-center">
                    <td>@department.Code</td>
                    <td>@department.Name</td>
                    <td>@department.Description</td>
                    <td>@department.DateOfCreation</td>
                    <td><a class="btn btn-primary" asp-action="Details"><i class="fas fa-eye"></i> Details</a></td>
                    <td><a class="btn btn-success" asp-action="Edit"><i class="fas fa-edit"></i> Edit</a></td>
                    <td><a class="btn btn-danger" asp-action="Edit"><i class="fas fa-trash"></i> Delete</a></td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div>
        <h2 class="alert alert-info mt-2">No Departments Found !!</h2>
    </div>
}


