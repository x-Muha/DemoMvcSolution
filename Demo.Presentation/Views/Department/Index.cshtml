@model IEnumerable<DepartmentDTO> // Determine The model
@{
    ViewData["Title"] = "Index";
}

<h1 class="my-3">All Departments</h1>
<a class="btn btn-primary my-3" asp-controller="Department" asp-action="Create">Create New Department</a>
<br />

@if(Model?.Any()?? false)
{
    //Department
    <table class="table table-striped table-hover mt-2">
        <thead class="text-center fw-bold">
            <tr>
                <th>@Html.DisplayNameFor(D=>D.Code)</th>
                <th>@Html.DisplayNameFor(D=>D.Name)</th>
                <th>@Html.DisplayNameFor(D=>D.Description)</th>
                <th>@Html.DisplayNameFor(D=>D.DateOfCreation)</th>
                <th>Details</th>
                <th>Update</th>
                <th>Delete</th>
            </tr>
        </thead>
        <tbody>
            @foreach(var department in Model){
                <tr class="text-center">
                    <td>@department.Code</td>
                    <td>@department.Name</td>
                    <td>@department.Description</td>
                    <td>@department.DateOfCreation</td>
                    <td><a class="btn btn-primary" asp-action="Details" asp-route-Id="@department.DeptId"><i class="fas fa-eye"></i> Details</a></td>
                    <td><a class="btn btn-success" asp-action="Edit" asp-route-Id="@department.DeptId"><i class="fas fa-edit"></i> Edit</a></td>
                    <td>
                        <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#DeleteModal-@department.DeptId">
                            <i class="fas fa-trash"></i> Delete
                        </button>
                        <div class="modal fade" id="DeleteModal-@department.DeptId" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
                        <div class="modal-dialog">
                                <div class="modal-content">
                                    <div class="modal-header">
                                        <h1 class="modal-title fs-5" id="exampleModalLabel">Delete Department</h1>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                    </div>
                                    <div class="modal-body">
                                        Are You Sure to Delete @department.Name?
                                    </div>
                                    <div class="modal-footer">
                                        <form asp-action="Delete" asp-controller="Department" asp-route-id="@department.DeptId" class="mt-4">
                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                                            <input type="submit" value="Delete" class="btn btn-danger" />
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div>
        <h2 class="alert alert-info mt-2">No Departments Found !!</h2>
    </div>
}


