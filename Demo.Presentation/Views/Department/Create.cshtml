@model CreatedDepartmentDTO // The model That View render it
@{                          // Views Can only render 1 model only
    ViewData["Title"] = "Create";
}

<div class="row justify-content-center align-content-center mt-3">
    <h1 class="col-8 my-4">Create Department</h1>

    @*Upon Submitting The form will be directed to "post" Action "Create"*@
    <form class="col-8" method="post" asp-action="Create">

        @*recieve error msg upon database insertion error*@
        <div asp-validation-summary="ModelOnly" class="text-warning"></div>

        <div class="form-group mb-3">
            @* <label class="form-label" for="Code"></label> *@ 
            @* <input id="Code" name="Code" type="text" /> *@
            <label class="form-label" asp-for="Code"></label>@*Set Name*@
            <input asp-for="Code" class="form-control"/>@*Allow auto binding*@
            @*Validation for Required Attribute -> Respond with error msg*@
            <span asp-validation-for="Code" class="text-danger"></span>
        </div>
        <div class="form-group mb-3">
            <label class="form-label" asp-for="Name"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
        <div class="form-group mb-3">
            <label class="form-label" asp-for="Description"></label>
            <textarea class="form-control" asp-for="Description"></textarea>
        </div>
        <div class="form-group mb-3">
            <label class="form-label" asp-for="DateOfCreation"></label>
            <input type="date" asp-for="DateOfCreation" class="form-control" />
        </div>
        <div class="mt-4 m-auto">
            @*Submitting the Form by info provided in form tag*@
            <input class="btn btn-primary" type="submit" value="Create" />
            <a class="btn btn-outline-dark" asp-action="Index">Back to list</a>
        </div>
    </form>
</div>
